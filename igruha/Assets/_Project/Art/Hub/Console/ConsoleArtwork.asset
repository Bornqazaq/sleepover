  entries:
  - game: {fileID: 11400000, guid: 110aafff3be2840cdaf9f7f0d3a912a0, type: 2}
    cover: {fileID: 21300000, guid: 1c73e72f214d4488cbccc64b2bcc194e, type: 3}
    accent: {r: 0.59607846, g: 0.80784315, b: 0.8509804, a: 1}
    genre: "\u041F\u0420\u042F\u0422\u041A\u0418 \u0412 \u0422\u0415\u041C\u041D\u041E\u0422\u0415"
    summary: "\u041F\u043E\u0434\u043A\u0440\u0430\u0434\u0438\u0441\u044C \u043A
      \u0432\u0435\u0434\u0443\u0449\u0435\u043C\u0443 \u0438 \u0437\u0430\u043C\u0440\u0438,
      \u043A\u043E\u0433\u0434\u0430 \u043D\u0430 \u0442\u0435\u0431\u044F \u043F\u043E\u043F\u0430\u0434\u0451\u0442
      \u0441\u0432\u0435\u0442. \u041E\u0434\u043D\u043E \u043B\u0438\u0448\u043D\u0435\u0435
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u2014 \u0438 \u0442\u044B
      \u0432\u044B\u0434\u0430\u0448\u044C \u0441\u0435\u0431\u044F."
  - game: {fileID: 11400000, guid: fd51a5bd609e749f3a37d921b9573782, type: 2}
    cover: {fileID: 21300000, guid: 012327393612242eabafb03e052d3539, type: 3}
    accent: {r: 0.95686275, g: 0.74509805, b: 0.5058824, a: 1}
    genre: "\u041F\u041E\u0427\u0423\u0412\u0421\u0422\u0412\u0423\u0419 \u0412\u0420\u0415\u041C\u042F"
    summary: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 \u043A\u043D\u043E\u043F\u043A\u0443
      \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438 \u0435\u0451 \u0442\u043E\u0447\u043D\u043E
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F. \u0427\u0443\u0432\u0441\u0442\u0432\u043E
      \u0440\u0438\u0442\u043C\u0430 \u0441\u043F\u0430\u0441\u0451\u0442 \u0442\u0432\u043E\u044E
      \u043A\u043B\u0435\u0442\u043A\u0443 \u043E\u0442 \u0432\u0441\u0442\u0440\u0435\u0447\u0438
      \u0441 \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u043C."
  - game: {fileID: 11400000, guid: 334d5894e34be40c8a2cc73f5346f18f, type: 2}
    cover: {fileID: 21300000, guid: 03317600cd9bc4299bc771ab1505a0c6, type: 3}
    accent: {r: 0.8745098, g: 0.7647059, b: 0.56078434, a: 1}
    genre: "\u041B\u041E\u0413\u0418\u041A\u0410 \u0418 \u0418\u041D\u0422\u0423\u0418\u0426\u0418\u042F"
    summary: "\u0420\u0430\u0437\u0433\u0430\u0434\u0430\u0439 \u0442\u0430\u0439\u043D\u0443\u044E
      \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u0446\u0432\u0435\u0442\u043D\u044B\u0445
      \u0431\u0430\u043D\u043E\u043A. \u041A\u0430\u0436\u0434\u0430\u044F \u043F\u043E\u043F\u044B\u0442\u043A\u0430
      \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0442, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0443\u0436\u0435 \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0441\u0432\u043E\u0438\u0445
      \u043C\u0435\u0441\u0442\u0430\u0445."
  - game: {fileID: 11400000, guid: 4062d177f707e42138fd1beaf71acf6b, type: 2}
    cover: {fileID: 21300000, guid: 687d0aa79951642378dd5782aefc6f5d, type: 3}
    accent: {r: 0.8745098, g: 0.6745098, b: 0.9137255, a: 1}
    genre: "\u0423\u0413\u0410\u0414\u0410\u0419 \u041C\u042B\u0421\u041B\u0418 \u0412\u0415\u0414\u0423\u0429\u0415\u0413\u041E"
    summary: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443
      \u0441 \u043E\u0442\u0432\u0435\u0442\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0437\u0430\u0433\u0430\u0434\u0430\u043B \u0432\u0435\u0434\u0443\u0449\u0438\u0439.
      \u0417\u0434\u0435\u0441\u044C \u0432\u0430\u0436\u043D\u0435\u0435 \u043F\u043E\u043D\u044F\u0442\u044C
      \u0434\u0440\u0443\u0433\u0430, \u0447\u0435\u043C \u0437\u043D\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442."
  - game: {fileID: 11400000, guid: 987ee41289bf1e649862d5d2343f1acc, type: 2}
    cover: {fileID: 21300000, guid: 9e788f155261742fa919807e48856702, type: 3}
    accent: {r: 0.78039217, g: 0.827451, b: 0.6117647, a: 1}
    genre: "\u0411\u041B\u0415\u0424 \u0417\u0410 \u041E\u0414\u041D\u0418\u041C
      \u0421\u0422\u041E\u041B\u041E\u041C"
    summary: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u043E\u044E
      \u043A\u043E\u0440\u043E\u0431\u043A\u0443 \u0438\u043B\u0438 \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F?
      \u0427\u0438\u0442\u0430\u0439 \u044D\u043C\u043E\u0446\u0438\u0438 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430
      \u0438 \u043D\u0430\u0439\u0434\u0438 \u043A\u0430\u0440\u0442\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442 \u043F\u043E\u0431\u0435\u0434\u0443."
  - game: {fileID: 11400000, guid: 63f3583b6900b1140a19b7bf99f194b4, type: 2}
    cover: {fileID: 21300000, guid: 6bdf31508c5b8432aab8038033dc3961, type: 3}
    accent: {r: 0.73333335, g: 0.7019608, b: 0.9411765, a: 1}
    genre: "\u0417\u0410\u041F\u041E\u041C\u041D\u0418 \u0411\u0415\u0417\u041E\u041F\u0410\u0421\u041D\u042B\u0419
      \u041F\u0423\u0422\u042C"
    summary: "\u041F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439 \u0442\u0440\u0438
      \u0434\u043E\u0440\u043E\u0436\u043A\u0438 \u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0434\u0438\u043D \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439
      \u0448\u0430\u0433. \u0417\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439
      \u043F\u0443\u0442\u044C \u0438 \u0434\u043E\u0431\u0435\u0440\u0438\u0441\u044C
      \u0434\u043E \u0444\u0438\u043D\u0438\u0448\u0430."
  - game: {fileID: 11400000, guid: 44929db2eefcd9a4e9bb71f668508e21, type: 2}
    cover: {fileID: 21300000, guid: a043dfd02284c4dc79026dbafc8a129b, type: 3}
    accent: {r: 0.5686275, g: 0.8392157, b: 0.8039216, a: 1}
    genre: "\u0412\u041C\u0415\u0421\u0422\u0415 \u0414\u041E \u041F\u041E\u0421\u041B\u0415\u0414\u041D\u0415\u0419
      \u041A\u0410\u041F\u041B\u0418"
    summary: "\u0414\u043E\u043D\u0435\u0441\u0438\u0442\u0435 \u0432\u043E\u0434\u0443
      \u0434\u043E \u0441\u0432\u043E\u0435\u0439 \u0451\u043C\u043A\u043E\u0441\u0442\u0438
      \u0432\u0441\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439.
      \u0421\u043F\u0435\u0448\u0438\u0442\u044C \u043C\u043E\u0436\u043D\u043E \u2014
      \u043D\u043E \u043A\u0430\u0436\u0434\u0430\u044F \u043F\u0440\u043E\u043B\u0438\u0442\u0430\u044F
      \u043A\u0430\u043F\u043B\u044F \u043E\u0442\u0434\u0430\u043B\u044F\u0435\u0442
      \u043F\u043E\u0431\u0435\u0434\u0443."
  - game: {fileID: 11400000, guid: 8103d0489459e7c48bc015b77858f725, type: 2}
    cover: {fileID: 21300000, guid: 8e63e807537cb4ae294106a8b3fcbed5, type: 3}
    accent: {r: 0.95686275, g: 0.6784314, b: 0.69803923, a: 1}
    genre: "\u041F\u041E\u041F\u0410\u0414\u0418 \u0412 \u0421\u0418\u041B\u0423\u042D\u0422"
    summary: "\u0412\u044B \u0441\u0432\u044F\u0437\u0430\u043D\u044B \u043E\u0434\u043D\u043E\u0439
      \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439, \u0430 \u0441\u0442\u0435\u043D\u0430
      \u0443\u0436\u0435 \u0431\u043B\u0438\u0437\u043A\u043E. \u0417\u0430\u0439\u043C\u0438\u0442\u0435
      \u043D\u0443\u0436\u043D\u044B\u0435 \u043F\u043E\u0437\u044B \u0438 \u043F\u0440\u043E\u0439\u0434\u0438\u0442\u0435
      \u0441\u043A\u0432\u043E\u0437\u044C \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F
      \u0432\u043C\u0435\u0441\u0442\u0435."
  - game: {fileID: 11400000, guid: 2b97e29082d037d49ab5c91ee7352e5c, type: 2}
    cover: {fileID: 21300000, guid: 80f03c94f55fd49da8bd98f00bdaa158, type: 3}
    accent: {r: 0.9490196, g: 0.83137256, b: 0.49019608, a: 1}
    genre: "\u0413\u041E\u041D\u041A\u0410 \u041D\u0410 \u0412\u0415\u0420\u0428\u0418\u041D\u0423"
    summary: "\u0423\u0442\u043A\u0438 \u0448\u0442\u0443\u0440\u043C\u0443\u044E\u0442
      \u0431\u0430\u0448\u043D\u044E, \u043E\u0445\u043E\u0442\u043D\u0438\u043A
      \u043C\u0435\u0448\u0430\u0435\u0442 \u0438\u043C \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u0432\u0435\u0440\u0448\u0438\u043D\u044B. \u041B\u043E\u0432\u0443\u0448\u043A\u0438
      \u0438 \u043F\u044F\u0442\u044C \u044D\u0442\u0430\u0436\u0435\u0439 \u0434\u043E
      \u043F\u043E\u0431\u0435\u0434\u044B!"
  - game: {fileID: 11400000, guid: 28d4dd238d2a75d428100d85c44e45a2, type: 2}
    cover: {fileID: 21300000, guid: c4db3969daca94426bdcefbc3ad314c5, type: 3}
    accent: {r: 0.60784316, g: 0.8784314, b: 0.47843137, a: 1}
    genre: "\u0411\u0415\u0413\u0418, \u041F\u041E\u041A\u0410 \u0427\u0418\u0421\u0422\u042B\u0419"
    summary: "\u041E\u0434\u0438\u043D \u0437\u0430\u0440\u0430\u0436\u0451\u043D,
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0431\u0435\u0433\u0443\u0442.
      \u0417\u0435\u043B\u0451\u043D\u0430\u044F \u043A\u0440\u0430\u0441\u043A\u0430
      \u043B\u0438\u043F\u043D\u0435\u0442 \u043E\u0442 \u043A\u0430\u0441\u0430\u043D\u0438\u044F,
      \u0438 \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u043D\u043E\u0432\u044B\u043C
      \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u043C \u0431\u0435\u0436\u0430\u0442\u044C
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435\u043A\u0443\u0434\u0430."
