  m_Name: OneBullet
  m_EditorClassIdentifier: Igruha.Core::Igruha.Core.Minigame.MinigameDefinition
  displayName: "\u041E\u0434\u0438\u043D \u043F\u0430\u0442\u0440\u043E\u043D"
  category: 0
  sceneName: OneBullet
  roundDuration: 300
  minPlayers: 2
  maxPlayers: 8
  cameraMode: 0
  tutorialFont: {fileID: 0}
  objective: "\u041D\u0430\u0439\u0434\u0438 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442. \u041E\u0434\u0438\u043D \u043F\u0430\u0442\u0440\u043E\u043D
    \u2014 \u043E\u0434\u043D\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u0435. \u0412\u044B\u0436\u0438\u0432\u0438
    \u0438\u043B\u0438 \u0434\u0435\u0440\u0436\u0438 \u043E\u0440\u0443\u0436\u0438\u0435
    \u0432 \u043A\u043E\u043D\u0446\u0435 \u0440\u0430\u0443\u043D\u0434\u0430."
  controlHints:
  - "WASD \u2014 \u0431\u0435\u0433 \xB7 Space \u2014 \u043F\u0440\u044B\u0436\u043E\u043A
    \xB7 Ctrl \u2014 \u043F\u0440\u0438\u0441\u0435\u0434"
  - "\u041B\u041A\u041C \u2014 \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u0441
    \u043E\u0440\u0443\u0436\u0438\u0435\u043C \xB7 \u041F\u041A\u041C / Shift \u2014
    \u0442\u043E\u043B\u0447\u043E\u043A"
  - "\u041E\u0440\u0443\u0436\u0438\u0435 \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
    \u043A\u0430\u0441\u0430\u043D\u0438\u0435\u043C. \u041F\u043E\u0441\u043B\u0435
    \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u0438\u0449\u0438 \u0435\u0433\u043E
    \u0441\u043D\u043E\u0432\u0430."
  - "\u041D\u0430 \u0444\u0438\u043D\u0438\u0448\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043B\u044C
    \u043E\u0440\u0443\u0436\u0438\u044F \u043F\u0435\u0440\u0432\u044B\u0439; \u0437\u0430\u0442\u0435\u043C
    \u2014 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0438 \u0432\u0440\u0435\u043C\u044F
    \u0436\u0438\u0437\u043D\u0438."
  tutorialDuration: 6
  tutorialSteps:
  - "\u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442.
    \u0417\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B
    \u0438 \u0441\u043B\u0443\u0448\u0430\u0439 \u0448\u0430\u0433\u0438."
  - "\u041D\u0430\u0439\u0434\u0438 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440:
    \u043E\u0434\u0438\u043D \u0432\u044B\u0441\u0442\u0440\u0435\u043B, \u0434\u0430\u0436\u0435
    \u0435\u0441\u043B\u0438 \u043F\u0440\u043E\u043C\u0430\u0445\u043D\u0451\u0448\u044C\u0441\u044F."
  - "\u0412\u044B\u0436\u0438\u0432\u0438. \u041E\u0440\u0443\u0436\u0438\u0435 \u0432
    \u0440\u0443\u043A\u0435 \u043D\u0430 \u0444\u0438\u043D\u0438\u0448\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
    \u043F\u0435\u0440\u0432\u043E\u0435 \u043C\u0435\u0441\u0442\u043E."
  tutorialQuickHints: []
