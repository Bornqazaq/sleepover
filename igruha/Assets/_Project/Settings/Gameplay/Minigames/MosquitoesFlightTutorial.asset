  tutorialFont: {fileID: 0}
  objective: "\u041D\u0435 \u0434\u0430\u0439 \u0432\u0435\u043B\u0438\u043A\u0430\u043D\u0443
    \u0432\u044B\u0441\u043F\u0430\u0442\u044C\u0441\u044F \u0437\u0430 120 \u0441\u0435\u043A\u0443\u043D\u0434.
    \u0414\u0432\u0430 \u0443\u043A\u0443\u0441\u0430 \u0437\u0430 4 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
    \u0440\u0430\u0437\u0431\u0443\u0434\u044F\u0442 \u0435\u0433\u043E. \u041F\u043E\u0441\u043B\u0435
    \u0443\u043A\u0443\u0441\u0430 \u043F\u0435\u0440\u0435\u0440\u044B\u0432 5 \u0441\u0435\u043A\u0443\u043D\u0434
    \u2014 \u043D\u0430\u043F\u0430\u0434\u0430\u0439\u0442\u0435 \u0432\u043C\u0435\u0441\u0442\u0435.
    \u041F\u043E\u0441\u043B\u0435 \u0448\u043B\u0435\u043F\u043A\u0430 \u0442\u044B
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C \u0434\u043E
    \u043A\u043E\u043D\u0446\u0430 \u0440\u0430\u0443\u043D\u0434\u0430."
  controlHints:
  - "WASD \u2014 \u043F\u043E\u043B\u0451\u0442, Space / Ctrl \u2014 \u0432\u0432\u0435\u0440\u0445
    / \u0432\u043D\u0438\u0437"
  - "Shift \u2014 \u0442\u0438\u0445\u0438\u0439 \u043F\u043E\u043B\u0451\u0442"
  - "\u041B\u041A\u041C \u2014 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0443
    \u0433\u0440\u0443\u0434\u0438 0,5 \u0441\u0435\u043A\u0443\u043D\u0434\u044B"
  - "\u0412 \u043E\u043A\u043D\u043E \u043C\u043E\u0436\u043D\u043E \u0432\u043B\u0435\u0442\u0435\u0442\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0440\u0430\u0437.
    \u041D\u0430\u0437\u0430\u0434 \u043F\u0443\u0442\u0438 \u043D\u0435\u0442"
  tutorialDuration: 6
  tutorialSteps:
  - "\u0417\u0430 10 \u0441\u0435\u043A\u0443\u043D\u0434 \u0432\u043B\u0435\u0442\u0438
    \u0432 \u043E\u043A\u043D\u043E \u2014 \u0438\u043D\u0430\u0447\u0435 \u0441\u0442\u0440\u0435\u043A\u043E\u0437\u0430
    \u0441\u044A\u0435\u0441\u0442 \u0442\u0435\u0431\u044F"
  - "\u0417\u0430\u0436\u043C\u0438 \u041B\u041A\u041C \u043D\u0430 0,5 \u0441\u0435\u043A\u0443\u043D\u0434\u044B"
  - "\u0423\u043B\u0435\u0442\u0430\u0439 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443
    \u043D\u0430 5 \u0441\u0435\u043A\u0443\u043D\u0434"
  tutorialQuickHints:
  - "WASD + Space / Ctrl \u2014 \u043F\u043E\u043B\u0451\u0442"
  - "Shift \u2014 \u0442\u0438\u0445\u043E"
  - "\u041B\u041A\u041C \u2014 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0443\u043A\u0443\u0441"
