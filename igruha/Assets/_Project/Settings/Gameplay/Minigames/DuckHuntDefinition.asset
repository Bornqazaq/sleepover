  objective: "\u0423\u0442\u043A\u0438 \u0431\u0435\u0433\u0443\u0442 \u0441\u043D\u0438\u0437\u0443
    \u0432\u0432\u0435\u0440\u0445 \u043F\u043E \u043F\u044F\u0442\u0438 \u044D\u0442\u0430\u0436\u0430\u043C
    \u0431\u0430\u0448\u043D\u0438 \u0438 \u043B\u0435\u0437\u0443\u0442 \u043D\u0430
    \u043A\u0440\u044B\u0448\u0443. \u041E\u0445\u043E\u0442\u043D\u0438\u043A \u0437\u0430\u043F\u0435\u0440\u0442
    \u043D\u0430 \u043B\u0438\u0444\u0442\u0435 \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
    \u0438 \u043E\u0442\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u0435\u0442
    \u0438\u0445. \u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0443\u0431\u0438\u0432\u0430\u0435\u0442
    \u043D\u0430\u0441\u043C\u0435\u0440\u0442\u044C \u2014 \u0432\u0442\u043E\u0440\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438 \u043D\u0435\u0442. \u041A\u043D\u043E\u043F\u043A\u0438
    \u043D\u0430 \u044D\u0442\u0430\u0436\u0430\u0445 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u044E\u0442
    \u043B\u043E\u0432\u0443\u0448\u043A\u0438 \u043F\u0440\u043E\u0442\u0438\u0432
    \u0442\u0435\u0445, \u043A\u0442\u043E \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
  controlHints:
  - "WASD \u2014 \u0431\u0435\u0433, \u041F\u0440\u043E\u0431\u0435\u043B \u2014
    \u043F\u0440\u044B\u0436\u043E\u043A, Ctrl \u2014 \u043F\u0440\u0438\u0441\u0435\u0434"
  - "\u041B\u041A\u041C \u2014 \u0443\u0434\u0430\u0440 (\u0443 \u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0430
    \u2014 \u0432\u044B\u0441\u0442\u0440\u0435\u043B)"
  - "E \u2014 \u043A\u043D\u043E\u043F\u043A\u0430 \u043B\u043E\u0432\u0443\u0448\u043A\u0438
    (\u0443 \u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0430 \u2014 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430)"
  - "\u041E\u0445\u043E\u0442\u043D\u0438\u043A: W/S \u2014 \u043B\u0438\u0444\u0442
    \u0432\u0432\u0435\u0440\u0445 \u0438 \u0432\u043D\u0438\u0437, \u043C\u044B\u0448\u044C
    \u2014 \u043F\u0440\u0438\u0446\u0435\u043B"
  - "\u0423\u0442\u043A\u0438: \u0434\u043E\u0439\u0442\u0438 \u0434\u043E \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438
    \u043D\u0430 \u043A\u0440\u044B\u0448\u0435. \u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435
    \u2014 \u044D\u0442\u043E \u0441\u043C\u0435\u0440\u0442\u044C"
  tutorialDuration: 7
