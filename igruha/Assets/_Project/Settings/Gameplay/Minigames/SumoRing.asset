  tutorialFont: {fileID: 0}
  objective: "\u0412\u044B\u0442\u043E\u043B\u043A\u043D\u0438 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432
    \u0441 \u0440\u0438\u043D\u0433\u0430. \u041A\u0440\u0430\u0439 \u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
    \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0443\u0441\u0442\u043E\u044F\u0432\u0448\u0438\u0439
    \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442."
  controlHints:
  - "WASD \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \xB7 \u043C\u044B\u0448\u044C
    \u2014 \u043A\u0430\u043C\u0435\u0440\u0430"
  - "\u041B\u041A\u041C \u2014 \u0442\u043E\u043B\u0447\u043E\u043A \xB7 Space \u2014
    \u043F\u0440\u044B\u0436\u043E\u043A"
  - "\u0422\u0440\u0435\u0449\u0438\u043D\u044B \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u044E\u0442
    \u043E\u0431 \u043E\u0431\u0432\u0430\u043B\u0435 \u0437\u0430 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B."
  - "\u0423\u043F\u0430\u043B \u0441 \u0440\u0438\u043D\u0433\u0430 \u2014 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0448\u044C.
    \u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439
    \u0432\u044B\u043B\u0435\u0442 \u0434\u0435\u043B\u0438\u0442 \u043C\u0435\u0441\u0442\u043E."
  tutorialDuration: 6
  tutorialSteps:
  - "\u041F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0443
    \u0438 \u0442\u043E\u043B\u043A\u043D\u0438 \u0435\u0433\u043E \u0437\u0430 \u043A\u0440\u0430\u0439."
  - "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0442\u0440\u0435\u0449\u0438\u043D\u0430\u043C\u0438:
    \u0432\u043D\u0435\u0448\u043D\u0438\u0435 \u043A\u043E\u043B\u044C\u0446\u0430
    \u043E\u0441\u044B\u043F\u0430\u044E\u0442\u0441\u044F."
  - "\u0417\u0430\u0439\u043C\u0438 \u0446\u0435\u043D\u0442\u0440 \u0438 \u043E\u0441\u0442\u0430\u043D\u044C\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u043D\u0430 \u0440\u0438\u043D\u0433\u0435."
  tutorialQuickHints:
  - "\u041B\u041A\u041C \u2014 \u0442\u043E\u043B\u0447\u043E\u043A"
  - "Space \u2014 \u043F\u0440\u044B\u0436\u043E\u043A"
  - "\u041A\u0440\u0430\u0439 \u0442\u0440\u0435\u0449\u0438\u0442 \u2014 \u043E\u0442\u043E\u0439\u0434\u0438
    \u043A \u0446\u0435\u043D\u0442\u0440\u0443"
