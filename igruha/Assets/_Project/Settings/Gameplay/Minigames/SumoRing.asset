  m_Name: SumoRing
  m_EditorClassIdentifier: Igruha.Core::Igruha.Core.Minigame.MinigameDefinition
  displayName: "\u0420\u0438\u043D\u0433 \u0441\u0443\u043C\u043E"
  category: 0
  sceneName: SumoRing
  roundDuration: 0
  minPlayers: 3
  maxPlayers: 8
  cameraMode: 0
  tutorialFont: {fileID: 0}
  objective: "\u0412\u044B\u0442\u043E\u043B\u043A\u043D\u0438 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432
    \u0441 \u0440\u0438\u043D\u0433\u0430. \u041A\u0440\u0430\u0439 \u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
    \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0443\u0441\u0442\u043E\u044F\u0432\u0448\u0438\u0439
    \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442."
  controlHints:
  - "\u041B\u041A\u041C \u2014 \u0442\u043E\u043B\u0447\u043E\u043A \xB7 \u0437\u0430\u0436\u043C\u0438
    \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438 \u041B\u041A\u041C \u2014 \u0441\u0438\u043B\u043E\u0432\u043E\u0439"
  - "\u041F\u041A\u041C \u2014 \u0437\u0430\u0449\u0438\u0442\u0430 \xB7 \u041F\u041A\u041C
    \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435\u043C
    \u2014 \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435"
  - "\u041F\u041A\u041C + \u041B\u041A\u041C / LT + RT \u2014 \u0440\u044B\u0432\u043E\u043A
    \u043F\u043B\u0435\u0447\u043E\u043C \xB7 \u043F\u043E\u0441\u043B\u0435 \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u2014 \u043E\u0442\u0432\u0435\u0442"
  - "WASD \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \xB7 Space \u2014
    \u043F\u0440\u044B\u0436\u043E\u043A \xB7 \u0433\u0435\u0439\u043C\u043F\u0430\u0434:
    RT / LT"
  tutorialDuration: 6
  tutorialSteps:
  - "\u0422\u043E\u043B\u043A\u0430\u0439 \u043A \u043A\u0440\u0430\u044E. \u0417\u0430\u0436\u043C\u0438
    \u041B\u041A\u041C, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0431\u0438\u0442\u044C
    \u0437\u0430\u0449\u0438\u0442\u0443."
  - "\u0417\u0430\u0449\u0438\u0449\u0430\u0439\u0441\u044F \u043B\u0438\u0446\u043E\u043C
    \u043A \u0443\u0434\u0430\u0440\u0443. \u0422\u043E\u0447\u043D\u044B\u0439 \u0431\u043B\u043E\u043A
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u043E\u043D\u0442\u0440\u0430\u0442\u0430\u043A\u0443
    \u041B\u041A\u041C."
  - "\u0417\u0430\u0436\u043C\u0438 \u0437\u0430\u0449\u0438\u0442\u0443 \u0438 \u043D\u0430\u0436\u043C\u0438
    \u0442\u043E\u043B\u0447\u043E\u043A \u2014 \u0440\u044B\u0432\u043E\u043A. \u041D\u0435
    \u043F\u0440\u043E\u043C\u0430\u0445\u043D\u0438\u0441\u044C \u0443 \u043A\u0440\u0430\u044F!"
  tutorialQuickHints:
  - "\u041B\u041A\u041C \u2014 \u0442\u043E\u043B\u0447\u043E\u043A / \u0437\u0430\u0440\u044F\u0434"
  - "\u041F\u041A\u041C \u2014 \u0431\u043B\u043E\u043A / \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435"
  - "\u041F\u041A\u041C + \u041B\u041A\u041C \u2014 \u0440\u044B\u0432\u043E\u043A"
