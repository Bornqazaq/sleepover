  displayName: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0431\u0430\u043D\u043E\u043A"
  category: 0
  sceneName: CansOrder
  roundDuration: 600
  minPlayers: 2
  maxPlayers: 8
  cameraMode: 0
  objective: "\u0415\u0441\u0442\u044C \u043E\u0434\u043D\u0430 \u0441\u043A\u0440\u044B\u0442\u0430\u044F
    \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0431\u0430\u043D\u043E\u043A
    \u2014 \u043E\u0434\u043D\u0430 \u043D\u0430 \u0432\u0441\u0435\u0445, \u0438
    \u0435\u0451 \u043D\u0435 \u043F\u043E\u043A\u0430\u0436\u0443\u0442.\n\u041A\u0430\u0436\u0434\u044B\u0439
    \u043A\u0440\u0443\u0433 \u0432\u044B\u0441\u0442\u0430\u0432\u044C \u0441\u0432\u043E\u0439
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439.\n\n\u0412 \u043E\u0442\u0432\u0435\u0442
    \u0442\u044B \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0421\u041A\u041E\u041B\u042C\u041A\u041E \u0431\u0430\u043D\u043E\u043A \u0441\u0442\u043E\u044F\u0442
    \u043D\u0430 \u0441\u0432\u043E\u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u0445.\n\u041A\u0430\u043A\u0438\u0435
    \u0438\u043C\u0435\u043D\u043D\u043E \u2014 \u043D\u0435 \u0441\u043A\u0430\u0436\u0443\u0442
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430.\n\n\u0422\u0430\u0431\u043B\u043E
    \u0437\u0430\u0433\u043E\u0440\u0438\u0442\u0441\u044F \u043D\u0430 5 \u0441\u0435\u043A\u0443\u043D\u0434:
    \u0442\u0440\u0438 \u043B\u0443\u0447\u0448\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
    \u043A\u0440\u0443\u0433\u0430 \u0438 \u0441\u0447\u0451\u0442 \u0443 \u0432\u0441\u0435\u0445.\n\u041F\u043E\u0442\u043E\u043C
    \u043F\u043E\u0433\u0430\u0441\u043D\u0435\u0442 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
    \u2014 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C \u043D\u0430\u0434\u043E
    \u0441\u0430\u043C\u043E\u043C\u0443.\n\n\u041A\u0442\u043E \u0435\u0449\u0451
    \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u043B, \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u0431\u043B\u0438\u0436\u0435 \u043A \u043C\u0435\u0434\u0432\u0435\u0434\u044E.
    \u0421\u043E\u0431\u0440\u0430\u043B \u2014 \u043E\u0441\u0442\u0430\u0451\u0448\u044C\u0441\u044F
    \u043D\u0430\u0432\u0435\u0440\u0445\u0443."
  controlHints:
  - "\u041C\u044B\u0448\u044C \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438
    \u0432\u0435\u0434\u0443\u0442 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0443
    \u043F\u043E \u0440\u044F\u0434\u0443 \u0431\u0430\u043D\u043E\u043A"
  - "E \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0431\u0430\u043D\u043A\u0443,
    E \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u2014 \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
    \u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u043C\u0438"
  - "Enter \u2014 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
    \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 (\u0438\u043B\u0438
    E \u043D\u0430 \u044F\u0447\u0435\u0439\u043A\u0435 \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
    \u0431\u0430\u043D\u043A\u043E\u0439)"
  - "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B \u2014 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441\u043E \u0432\u0441\u0435\u043C\u0438, \u043D\u0435 \u0440\u0430\u043D\u044C\u0448\u0435"
  - "\u0412 \u043E\u043A\u043D\u0435 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u043D\u043E\u0433\u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u044B:
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441 \u043F\u043E\u043B\u043A\u043E\u0439"
  - "WASD \u2014 \u0431\u0435\u0433, \u041F\u0440\u043E\u0431\u0435\u043B \u2014
    \u043F\u0440\u044B\u0436\u043E\u043A, Tab \u2014 \u044D\u043C\u043E\u0446\u0438\u0438"
  tutorialDuration: 14
