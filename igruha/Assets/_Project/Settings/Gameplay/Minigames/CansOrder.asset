  m_Name: CansOrder
  m_EditorClassIdentifier: Igruha.Core::Igruha.Core.Minigame.MinigameDefinition
  displayName: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0431\u0430\u043D\u043E\u043A"
  category: 0
  sceneName: CansOrder
  roundDuration: 120
  minPlayers: 2
  maxPlayers: 8
  cameraMode: 0
  tutorialFont: {fileID: 11400000, guid: 87b63952b34fc45079bca7750c2ef239, type: 2}
  objective: "\u0423\u0433\u0430\u0434\u0430\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
    \u0431\u0430\u043D\u043E\u043A \u0437\u0430 120 \u0441\u0435\u043A\u0443\u043D\u0434.
    \u041F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0445\u043E\u0434\u0430
    \u043A\u043B\u0435\u0442\u043A\u0430 \u0438\u0433\u0440\u043E\u043A\u0430 \u0441
    \u043D\u0430\u0438\u043C\u0435\u043D\u044C\u0448\u0438\u043C \u0447\u0438\u0441\u043B\u043E\u043C
    \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0439 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043E\u0434\u0438\u043D \u0443\u0440\u043E\u0432\u0435\u043D\u044C.
    \u041F\u0440\u0438 \u0440\u0430\u0432\u0435\u043D\u0441\u0442\u0432\u0435 \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F
    \u0432\u0441\u0435 \u0441 \u0445\u0443\u0434\u0448\u0438\u043C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u043C.
    \u0412\u043D\u0438\u0437\u0443 \u2014 \u0434\u0432\u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0448\u0430\u043D\u0441\u0430: \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0432\u0430
    \u043D\u043E\u0432\u044B\u0445 \u0445\u0443\u0434\u0448\u0438\u0445 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430
    \u043E\u0442\u043A\u0440\u043E\u044E\u0442 \u043B\u044E\u043A. \u0421\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F
    \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0441\u043F\u0430\u0441\u0430\u0435\u0442
    \u043A\u043B\u0435\u0442\u043A\u0443. \u041A\u043E\u043D\u0435\u0446 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435 \u043B\u044E\u043A \u043D\u0435
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442."
  controlHints:
  - "\u041C\u044B\u0448\u044C \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438
    \u0432\u0435\u0434\u0443\u0442 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0443
    \u043F\u043E \u0440\u044F\u0434\u0443 \u0431\u0430\u043D\u043E\u043A"
  - "\u041B\u041A\u041C \u0438\u043B\u0438 \u0437\u0430\u0436\u043C\u0438 E \u2014
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0431\u0430\u043D\u043A\u0443; \u043F\u043E\u0432\u0442\u043E\u0440\u0438
    \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439, \u0447\u0442\u043E\u0431\u044B
    \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C \u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u043C\u0438"
  - "Enter \u2014 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
    \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 (\u0438\u043B\u0438
    \u0437\u0430\u0436\u043C\u0438 E \u043D\u0430 \u044F\u0447\u0435\u0439\u043A\u0435
    \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0431\u0430\u043D\u043A\u043E\u0439)"
  - "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B \u2014 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441\u043E \u0432\u0441\u0435\u043C\u0438, \u043D\u0435 \u0440\u0430\u043D\u044C\u0448\u0435"
  - "\u0412 \u043E\u043A\u043D\u0435 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u043D\u043E\u0433\u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u044B:
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441 \u043F\u043E\u043B\u043A\u043E\u0439"
  - "WASD \u2014 \u0431\u0435\u0433, \u041F\u0440\u043E\u0431\u0435\u043B \u2014
    \u043F\u0440\u044B\u0436\u043E\u043A, Tab \u2014 \u044D\u043C\u043E\u0446\u0438\u0438"
  tutorialDuration: 14
  tutorialSteps:
  - "\u041C\u0415\u041D\u042F\u0419 \u0411\u0410\u041D\u041A\u0418 \u2022 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438
    \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0438 \u0443\u0437\u043D\u0430\u0439
    \u0447\u0438\u0441\u043B\u043E \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0439."
  - "\u0425\u0423\u0414\u0428\u0418\u0419 \u0420\u0415\u0417\u0423\u041B\u042C\u0422\u0410\u0422
    \u0425\u041E\u0414\u0410 \u2022 \u043A\u043B\u0435\u0442\u043A\u0430 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043E\u0434\u0438\u043D \u0443\u0440\u043E\u0432\u0435\u043D\u044C."
  - "\u0414\u0412\u0410 \u0428\u0410\u041D\u0421\u0410 \u0412\u041D\u0418\u0417\u0423
    \u2022 \u0434\u0432\u0430 \u043D\u043E\u0432\u044B\u0445 \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043D\u043D\u044B\u0445
    \u0445\u043E\u0434\u0430 \u043E\u0442\u043A\u0440\u043E\u044E\u0442 \u043B\u044E\u043A.
    \u0421\u043E\u0431\u0435\u0440\u0438 \u0432\u0441\u0451 \u0438 \u0441\u043F\u0430\u0441\u0438
    \u043A\u043B\u0435\u0442\u043A\u0443."
  tutorialQuickHints:
  - "\u0425\u0443\u0434\u0448\u0438\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u2014 \u0432\u043D\u0438\u0437; \u043F\u0440\u0438 \u0440\u0430\u0432\u0435\u043D\u0441\u0442\u0432\u0435
    \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F \u0432\u0441\u0435
    \u0445\u0443\u0434\u0448\u0438\u0435."
  - "\u0412 \u043D\u0438\u0436\u043D\u0435\u0439 \u043A\u043B\u0435\u0442\u043A\u0435
    \u0434\u0432\u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0448\u0430\u043D\u0441\u0430."
  - "Enter \u2014 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
    \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0431\u0430\u043D\u043E\u043A."
