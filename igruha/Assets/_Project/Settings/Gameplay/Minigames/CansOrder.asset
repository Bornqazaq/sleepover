  displayName: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0431\u0430\u043D\u043E\u043A"
  category: 0
  sceneName: CansOrder
  roundDuration: 120
  minPlayers: 2
  maxPlayers: 8
  cameraMode: 0
  tutorialFont: {fileID: 11400000, guid: 87b63952b34fc45079bca7750c2ef239, type: 2}
  objective: "\u041E\u0434\u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430
    \u043D\u0430 120 \u0441\u0435\u043A\u0443\u043D\u0434. \u041F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u044F\u0439
    \u0431\u0430\u043D\u043A\u0438 \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0439
    \u043F\u043E\u0440\u044F\u0434\u043E\u043A. \u041F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0439
    \u043E\u0431\u0449\u0435\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
    \u0442\u0430\u0431\u043B\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044F \u043F\u043E \u043F\u043E\u0437\u0438\u0446\u0438\u044F\u043C.
    \u0417\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
    \u0438 \u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u043D\u043E\u0432\u0430. \u0421\u043E\u0431\u0440\u0430\u0432\u0448\u0438\u0435
    \u0444\u0438\u043D\u0438\u0448\u0438\u0440\u0443\u044E\u0442: \u0440\u0430\u043D\u044C\u0448\u0435
    \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B \u0432\u0435\u0440\u043D\u044B\u0439
    \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u2014 \u0432\u044B\u0448\u0435 \u043C\u0435\u0441\u0442\u043E.
    \u041D\u0435 \u0443\u0441\u043F\u0435\u0432\u0448\u0438\u0435 \u0437\u0430 120
    \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u0430\u0434\u0430\u044E\u0442 \u043A
    \u043C\u0435\u0434\u0432\u0435\u0434\u044E \u0438 \u0434\u0435\u043B\u044F\u0442
    \u043C\u0435\u0441\u0442\u043E \u043D\u0438\u0436\u0435 \u0432\u0441\u0435\u0445
    \u0444\u0438\u043D\u0438\u0448\u0438\u0440\u043E\u0432\u0430\u0432\u0448\u0438\u0445.
    \u0412\u0442\u043E\u0440\u043E\u0433\u043E \u0440\u0430\u0443\u043D\u0434\u0430
    \u043D\u0435\u0442."
  controlHints:
  - "\u041C\u044B\u0448\u044C \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438
    \u0432\u0435\u0434\u0443\u0442 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0443
    \u043F\u043E \u0440\u044F\u0434\u0443 \u0431\u0430\u043D\u043E\u043A"
  - "E \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0431\u0430\u043D\u043A\u0443,
    E \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u2014 \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
    \u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u043C\u0438"
  - "Enter \u2014 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
    \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 (\u0438\u043B\u0438
    E \u043D\u0430 \u044F\u0447\u0435\u0439\u043A\u0435 \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
    \u0431\u0430\u043D\u043A\u043E\u0439)"
  - "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B \u2014 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441\u043E \u0432\u0441\u0435\u043C\u0438, \u043D\u0435 \u0440\u0430\u043D\u044C\u0448\u0435"
  - "\u0412 \u043E\u043A\u043D\u0435 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u043D\u043E\u0433\u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u044B:
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441 \u043F\u043E\u043B\u043A\u043E\u0439"
  - "WASD \u2014 \u0431\u0435\u0433, \u041F\u0440\u043E\u0431\u0435\u043B \u2014
    \u043F\u0440\u044B\u0436\u043E\u043A, Tab \u2014 \u044D\u043C\u043E\u0446\u0438\u0438"
  tutorialDuration: 14
  tutorialSteps:
  - "\u041E\u0434\u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430.
    \u0423 \u0442\u0435\u0431\u044F 120 \u0441\u0435\u043A\u0443\u043D\u0434."
  - "\u041F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u044F\u0439, \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0439
    \u0438 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044F."
  - "\u0421\u043E\u0431\u0435\u0440\u0438 \u0440\u0430\u043D\u044C\u0448\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445;
    \u043D\u0435\u0443\u0441\u043F\u0435\u0432\u0448\u0438\u0435 \u2014 \u043A \u043C\u0435\u0434\u0432\u0435\u0434\u044E."
  tutorialQuickHints:
  - "E \u2014 \u0432\u044B\u0431\u0435\u0440\u0438 / \u043F\u043E\u043C\u0435\u043D\u044F\u0439
    \u0431\u0430\u043D\u043A\u0438"
  - "Enter \u2014 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043F\u043E\u0440\u044F\u0434\u043E\u043A"
  - "WASD \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
