  roundDuration: 600
  minPlayers: 2
  maxPlayers: 8
  cameraMode: 0
  objective: "\u0415\u0441\u0442\u044C \u043E\u0434\u043D\u0430 \u0441\u043A\u0440\u044B\u0442\u0430\u044F
    \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0431\u0430\u043D\u043E\u043A
    \u2014 \u043E\u0434\u043D\u0430 \u043D\u0430 \u0432\u0441\u0435\u0445, \u0438
    \u0435\u0451 \u043D\u0435 \u043F\u043E\u043A\u0430\u0436\u0443\u0442.\n\u041A\u0430\u0436\u0434\u044B\u0435
    10 \u0441\u0435\u043A\u0443\u043D\u0434 \u0432\u044B\u0441\u0442\u0430\u0432\u044C
    \u0441\u0432\u043E\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439.\n\u0422\u0430\u0431\u043B\u043E \u043D\u0430
    5 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u043A\u0430\u0436\u0435\u0442
    \u0442\u0440\u0438 \u043B\u0443\u0447\u0448\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
    \u043A\u0440\u0443\u0433\u0430 \u0438 \u0441\u0447\u0451\u0442 \u0443 \u0432\u0441\u0435\u0445.\n\u0417\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439:
    \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437 \u0438\u0445 \u043D\u0435
    \u043F\u043E\u043A\u0430\u0436\u0443\u0442.\n\u041A\u0442\u043E \u0435\u0449\u0451
    \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u043B \u2014 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u0431\u043B\u0438\u0436\u0435 \u043A \u043C\u0435\u0434\u0432\u0435\u0434\u044E.
    \u0421\u043E\u0431\u0440\u0430\u043B \u2014 \u043E\u0441\u0442\u0430\u0451\u0448\u044C\u0441\u044F
    \u043D\u0430\u0432\u0435\u0440\u0445\u0443."
  controlHints:
  - "WASD \u2014 \u0431\u0435\u0433, \u041F\u0440\u043E\u0431\u0435\u043B \u2014
    \u043F\u0440\u044B\u0436\u043E\u043A"
  - "E \u043D\u0430 \u0431\u0430\u043D\u043A\u0435 \u2014 \u0432\u0437\u044F\u0442\u044C,
    \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u043C \u0441\u043B\u043E\u0442\u0435
    \u2014 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C"
  - "E \u043D\u0430 \u0437\u0430\u043D\u044F\u0442\u043E\u043C \u0441\u043B\u043E\u0442\u0435
    \u0441 \u0431\u0430\u043D\u043A\u043E\u0439 \u0432 \u0440\u0443\u043A\u0435 \u2014
    \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u0430\u043C\u0438"
  - "E \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0435 \u2014 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
    \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 (\u0440\u0443\u043A\u0438
    \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u043F\u0443\u0441\u0442\u044B)"
