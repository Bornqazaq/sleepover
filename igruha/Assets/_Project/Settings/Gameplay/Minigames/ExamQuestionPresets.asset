  presets:
  - Question: "\u0427\u0442\u043E \u0445\u0443\u0436\u0435 \u2014 \u043E\u043F\u043E\u0437\u0434\u0430\u0442\u044C
      \u043D\u0430 \u0447\u0430\u0441 \u0438\u043B\u0438 \u043D\u0435 \u043F\u0440\u0438\u0439\u0442\u0438
      \u0432\u043E\u043E\u0431\u0449\u0435?"
    OptionA: "\u041E\u043F\u043E\u0437\u0434\u0430\u0442\u044C"
    OptionB: "\u041D\u0435 \u043F\u0440\u0438\u0439\u0442\u0438"
  - Question: "\u041F\u0435\u043B\u044C\u043C\u0435\u043D\u0438 \u0441\u043E \u0441\u043C\u0435\u0442\u0430\u043D\u043E\u0439
      \u0438\u043B\u0438 \u0441 \u043C\u0430\u0439\u043E\u043D\u0435\u0437\u043E\u043C?"
    OptionA: "\u0421\u043C\u0435\u0442\u0430\u043D\u0430"
    OptionB: "\u041C\u0430\u0439\u043E\u043D\u0435\u0437"
  - Question: "\u041A\u0442\u043E \u0438\u0437 \u043D\u0430\u0441 \u043F\u0435\u0440\u0432\u044B\u043C
      \u0436\u0435\u043D\u0438\u0442\u0441\u044F?"
    OptionA: "\u0422\u043E\u0447\u043D\u043E \u043D\u0435 \u044F"
    OptionB: "\u0421\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432
      \u044F"
  - Question: "\u0410\u043D\u0430\u043D\u0430\u0441 \u043D\u0430 \u043F\u0438\u0446\u0446\u0435
      \u2014 \u044D\u0442\u043E \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435?"
    OptionA: "\u041F\u0440\u0435\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435"
    OptionB: "\u0412\u043A\u0443\u0441\u043D\u043E"
  - Question: "\u0414\u0443\u0448 \u0443\u0442\u0440\u043E\u043C \u0438\u043B\u0438
      \u0432\u0435\u0447\u0435\u0440\u043E\u043C?"
    OptionA: "\u0423\u0442\u0440\u043E\u043C"
    OptionB: "\u0412\u0435\u0447\u0435\u0440\u043E\u043C"
  - Question: "\u0427\u0442\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435
      \u2014 \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0434
      \u0437\u0430\u043B\u043E\u043C \u0438\u043B\u0438 \u0438\u0434\u0442\u0438
      \u043A \u0441\u0442\u043E\u043C\u0430\u0442\u043E\u043B\u043E\u0433\u0443?"
    OptionA: "\u0417\u0430\u043B"
    OptionB: "\u0421\u0442\u043E\u043C\u0430\u0442\u043E\u043B\u043E\u0433"
  - Question: "\u041A\u043E\u0444\u0435 \u0438\u043B\u0438 \u0447\u0430\u0439, \u0435\u0441\u043B\u0438
      \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430?"
    OptionA: "\u041A\u043E\u0444\u0435"
    OptionB: "\u0427\u0430\u0439"
  - Question: "\u0427\u0438\u0442\u0430\u0442\u044C \u043A\u043D\u0438\u0433\u0443
      \u0438\u043B\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u044D\u043A\u0440\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044E?"
    OptionA: "\u041A\u043D\u0438\u0433\u0430"
    OptionB: "\u0424\u0438\u043B\u044C\u043C"
  - Question: "\u041A\u0442\u043E \u0432 \u044D\u0442\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u0445\u0443\u0436\u0435 \u0432\u0441\u0435\u0445 \u0432\u043E\u0434\u0438\u0442?"
    OptionA: "\u0421\u0438\u0434\u044F\u0449\u0438\u0439 \u0441\u043B\u0435\u0432\u0430"
    OptionB: "\u0421\u0438\u0434\u044F\u0449\u0438\u0439 \u0441\u043F\u0440\u0430\u0432\u0430"
  - Question: "\u041E\u0442\u043F\u0443\u0441\u043A \u0432 \u0433\u043E\u0440\u0430\u0445
      \u0438\u043B\u0438 \u043D\u0430 \u043C\u043E\u0440\u0435?"
    OptionA: "\u0413\u043E\u0440\u044B"
    OptionB: "\u041C\u043E\u0440\u0435"
  - Question: "\u0427\u0442\u043E \u0432\u0430\u0436\u043D\u0435\u0435 \u0432 \u0434\u0440\u0443\u0433\u0435
      \u2014 \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u0438\u043B\u0438
      \u0434\u043E\u0431\u0440\u043E\u0442\u0430?"
    OptionA: "\u0427\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C"
    OptionB: "\u0414\u043E\u0431\u0440\u043E\u0442\u0430"
  - Question: "\u0421\u043E\u0432\u0430 \u0438\u043B\u0438 \u0436\u0430\u0432\u043E\u0440\u043E\u043D\u043E\u043A?"
    OptionA: "\u0421\u043E\u0432\u0430"
    OptionB: "\u0416\u0430\u0432\u043E\u0440\u043E\u043D\u043E\u043A"
  - Question: "\u041F\u043E\u0437\u0432\u043E\u043D\u0438\u0442\u044C \u0438\u043B\u0438
      \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C?"
    OptionA: "\u041F\u043E\u0437\u0432\u043E\u043D\u0438\u0442\u044C"
    OptionB: "\u041D\u0430\u043F\u0438\u0441\u0430\u0442\u044C"
  - Question: "\u0427\u0442\u043E \u0431\u0435\u0441\u0438\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0435
      \u2014 \u0447\u0430\u0432\u043A\u0430\u043D\u044C\u0435 \u0438\u043B\u0438
      \u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u044F?"
    OptionA: "\u0427\u0430\u0432\u043A\u0430\u043D\u044C\u0435"
    OptionB: "\u041E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u044F"
  - Question: "\u041A\u043E\u0448\u043A\u0438 \u0438\u043B\u0438 \u0441\u043E\u0431\u0430\u043A\u0438?"
    OptionA: "\u041A\u043E\u0448\u043A\u0438"
    OptionB: "\u0421\u043E\u0431\u0430\u043A\u0438"
  - Question: "\u0421\u0435\u0440\u0438\u0430\u043B \u0437\u0430\u043B\u043F\u043E\u043C
      \u0438\u043B\u0438 \u043F\u043E \u0441\u0435\u0440\u0438\u0438 \u0432 \u043D\u0435\u0434\u0435\u043B\u044E?"
    OptionA: "\u0417\u0430\u043B\u043F\u043E\u043C"
    OptionB: "\u041F\u043E \u0441\u0435\u0440\u0438\u0438"
  - Question: "\u041B\u0443\u0447\u0448\u0435 \u043F\u0435\u0440\u0435\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0438\u043B\u0438 \u0441\u0442\u043E\u044F\u0442\u044C \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u0438?"
    OptionA: "\u041F\u0435\u0440\u0435\u043F\u043B\u0430\u0442\u0438\u0442\u044C"
    OptionB: "\u0421\u0442\u043E\u044F\u0442\u044C"
  - Question: "\u0427\u0442\u043E \u0445\u0443\u0436\u0435 \u2014 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0438\u043B\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u043A\u043B\u044E\u0447\u0438?"
    OptionA: "\u0422\u0435\u043B\u0435\u0444\u043E\u043D"
    OptionB: "\u041A\u043B\u044E\u0447\u0438"
  - Question: "\u0413\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u0430\u043C\u043E\u043C\u0443
      \u0438\u043B\u0438 \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C?"
    OptionA: "\u0413\u043E\u0442\u043E\u0432\u0438\u0442\u044C"
    OptionB: "\u0417\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C"
  - Question: "\u041A\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u043C \u0441\u0434\u0430\u0441\u0442\u0441\u044F
      \u0432 \u0441\u043F\u043E\u0440\u0435?"
    OptionA: "\u0422\u043E\u0442, \u043A\u0442\u043E \u0433\u0440\u043E\u043C\u0447\u0435"
    OptionB: "\u0422\u043E\u0442, \u043A\u0442\u043E \u043C\u043E\u043B\u0447\u0438\u0442"
  - Question: "\u0421\u043B\u0430\u0434\u043A\u043E\u0435 \u0438\u043B\u0438 \u0441\u043E\u043B\u0451\u043D\u043E\u0435?"
    OptionA: "\u0421\u043B\u0430\u0434\u043A\u043E\u0435"
    OptionB: "\u0421\u043E\u043B\u0451\u043D\u043E\u0435"
  - Question: "\u0427\u0442\u043E \u043B\u0443\u0447\u0448\u0435 \u2014 \u0437\u043D\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u0434\u0443 \u0438\u043B\u0438 \u0441\u043F\u0430\u0442\u044C
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E?"
    OptionA: "\u041F\u0440\u0430\u0432\u0434\u0430"
    OptionB: "\u0421\u043F\u0430\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E"
  - Question: "\u041E\u0442\u0432\u0435\u0447\u0430\u0442\u044C \u0441\u0440\u0430\u0437\u0443
      \u0438\u043B\u0438 \u043E\u0431\u0434\u0443\u043C\u0430\u0442\u044C \u0441\u0443\u0442\u043A\u0438?"
    OptionA: "\u0421\u0440\u0430\u0437\u0443"
    OptionB: "\u0427\u0435\u0440\u0435\u0437 \u0441\u0443\u0442\u043A\u0438"
  - Question: "\u0417\u0438\u043C\u0430 \u0438\u043B\u0438 \u043B\u0435\u0442\u043E?"
    OptionA: "\u0417\u0438\u043C\u0430"
    OptionB: "\u041B\u0435\u0442\u043E"
  - Question: "\u0427\u0442\u043E \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u2014 \u0441\u043F\u043E\u0439\u043B\u0435\u0440\u044B
      \u0438\u043B\u0438 \u0440\u0435\u043A\u043B\u0430\u043C\u0430?"
    OptionA: "\u0421\u043F\u043E\u0439\u043B\u0435\u0440\u044B"
    OptionB: "\u0420\u0435\u043A\u043B\u0430\u043C\u0430"
  - Question: "\u0421\u0438\u0434\u0435\u0442\u044C \u0443 \u043E\u043A\u043D\u0430
      \u0438\u043B\u0438 \u0443 \u043F\u0440\u043E\u0445\u043E\u0434\u0430?"
    OptionA: "\u0423 \u043E\u043A\u043D\u0430"
    OptionB: "\u0423 \u043F\u0440\u043E\u0445\u043E\u0434\u0430"
  - Question: "\u041F\u0440\u0438\u0437\u043D\u0430\u0442\u044C\u0441\u044F \u0432
      \u043E\u0448\u0438\u0431\u043A\u0435 \u0441\u0440\u0430\u0437\u0443 \u0438\u043B\u0438
      \u0442\u0438\u0445\u043E \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C?"
    OptionA: "\u041F\u0440\u0438\u0437\u043D\u0430\u0442\u044C\u0441\u044F"
    OptionB: "\u0418\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C"
  - Question: "\u0427\u0442\u043E \u0432\u0430\u0436\u043D\u0435\u0435 \u2014 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438\u043B\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F?"
    OptionA: "\u0414\u0435\u043D\u044C\u0433\u0438"
    OptionB: "\u0412\u0440\u0435\u043C\u044F"
  - Question: "\u041A\u0442\u043E \u0432 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
      \u0441\u0430\u043C\u044B\u0439 \u0436\u0430\u0434\u043D\u044B\u0439?"
    OptionA: "\u041E\u043D \u044D\u0442\u043E \u043E\u0442\u0440\u0438\u0446\u0430\u0435\u0442"
    OptionB: "\u041E\u043D \u044D\u0442\u0438\u043C \u0433\u043E\u0440\u0434\u0438\u0442\u0441\u044F"
  - Question: "\u0418\u0433\u0440\u0430\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C, \u0438\u043B\u0438 \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0441\u043C\u0435\u044F\u0442\u044C\u0441\u044F?"
    OptionA: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u044C"
    OptionB: "\u041F\u043E\u0441\u043C\u0435\u044F\u0442\u044C\u0441\u044F"
  - Question: "\u0427\u0442\u043E \u0445\u0443\u0436\u0435 \u2014 \u0433\u0440\u043E\u043C\u043A\u0438\u0439
      \u0441\u043E\u0441\u0435\u0434 \u0438\u043B\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F
      \u0431\u0430\u0442\u0430\u0440\u0435\u044F?"
    OptionA: "\u0421\u043E\u0441\u0435\u0434"
    OptionB: "\u0411\u0430\u0442\u0430\u0440\u0435\u044F"
  - Question: "\u041F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u0435\u0437\u0434\u043A\u0443 \u0438\u043B\u0438 \u0435\u0445\u0430\u0442\u044C
      \u043D\u0430\u0443\u0433\u0430\u0434?"
    OptionA: "\u041F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
    OptionB: "\u041D\u0430\u0443\u0433\u0430\u0434"
