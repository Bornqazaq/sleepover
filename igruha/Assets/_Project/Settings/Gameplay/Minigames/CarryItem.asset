  m_Script: {fileID: 11500000, guid: d880a78cefc77d64f871e75b18db2224, type: 3}
  m_Name: CarryItem
  m_EditorClassIdentifier: Igruha.Core::Igruha.Core.Minigame.MinigameDefinition
  displayName: "\u041F\u0435\u0440\u0435\u043D\u043E\u0441\u043A\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430"
  category: 1
  sceneName: CarryItem
  roundDuration: 200
  minPlayers: 2
  maxPlayers: 8
  cameraMode: 0
  tutorialFont: {fileID: 11400000, guid: 87b63952b34fc45079bca7750c2ef239, type: 2}
  objective: "\u0414\u043E\u0432\u0435\u0437\u0438\u0442\u0435 \u0432 \u0441\u0432\u043E\u0439
    \u0431\u0430\u043A \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u043E\u0434\u044B,
    \u0447\u0435\u043C \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A.\n\u0422\u0435\u043B\u0435\u0436\u043A\u0430
    \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0432\u043E\u0434\u0443, \u043F\u043E\u043A\u0430
    \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u0434 \u043A\u0440\u0430\u043D\u043E\u043C:
    \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u0438\u0448\u044C
    \u2014 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0438 \u0432\u0435\u0437\u0451\u0448\u044C.\n\u0411\u044B\u0441\u0442\u0440\u0435\u0435
    \u2014 \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442 \u043B\u0443\u0447\u0448\u0435:
    \u043F\u043E\u043B\u043D\u0430\u044F \u0442\u0435\u043B\u0435\u0436\u043A\u0430
    \u0442\u044F\u0436\u0451\u043B\u0430\u044F \u0438 \u043F\u043B\u0435\u0449\u0435\u0442
    \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0440\u044B\u0432\u043A\u0435."
  controlHints:
  - "E \u2014 \u0432\u0437\u044F\u0442\u044C\u0441\u044F \u0437\u0430 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u044C;
    \u043D\u0430\u0436\u043C\u0438 \u0435\u0449\u0451 \u0440\u0430\u0437, \u0447\u0442\u043E\u0431\u044B
    \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
  - "\u0421\u0442\u043E\u0439 \u0441 \u0442\u0435\u043B\u0435\u0436\u043A\u043E\u0439
    \u043F\u043E\u0434 \u043A\u0440\u0430\u043D\u043E\u043C \u2014 \u043E\u043D\u0430
    \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0432\u043E\u0434\u0443 \u0441\u0430\u043C\u0430"
  - "\u041F\u043E\u0434\u043A\u0430\u0442\u0438\u0442\u0435 \u0442\u0435\u043B\u0435\u0436\u043A\u0443
    \u043A \u043D\u0430\u0441\u043E\u0441\u0443 \u0443 \u0441\u0432\u043E\u0435\u0433\u043E
    \u0431\u0430\u043A\u0430 \u2014 \u043E\u043D \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
    \u043E\u0442\u043A\u0430\u0447\u0430\u0435\u0442 \u0432\u043E\u0434\u0443"
  - "\u041B\u041A\u041C \u0441 \u0442\u0435\u043B\u0435\u0436\u043A\u043E\u0439 \u2014
    \u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C \u0435\u0451 \u0441 \u0440\u0430\u0437\u0433\u043E\u043D\u0430
    \u0432\u0441\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439"
  - "\u041B\u041A\u041C \u0431\u0435\u0437 \u0442\u0435\u043B\u0435\u0436\u043A\u0438
    \u2014 \u0443\u0434\u0430\u0440\u0438\u0442\u044C; \u0443\u0434\u0430\u0440 \u043F\u043E
    \u043D\u0435\u0441\u0443\u0449\u0435\u043C\u0443 \u0441\u0440\u044B\u0432\u0430\u0435\u0442
    \u0435\u0433\u043E \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u044C"
  - "E \u0443 \u043A\u0443\u0447\u043A\u0438, \u043F\u043E\u0442\u043E\u043C \u041B\u041A\u041C
    \u2014 \u043C\u0435\u0442\u043D\u0443\u0442\u044C \u043A\u0438\u0440\u043F\u0438\u0447"
  tutorialDuration: 8
  tutorialSteps:
  - "E \u2014 \u0432\u0437\u044F\u0442\u044C\u0441\u044F. WASD \u2014 \u043A\u0430\u0442\u0438\u0442\u044C
    \u0438 \u043F\u043B\u0430\u0432\u043D\u043E \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C."
  - "\u0420\u0430\u0437\u043D\u044B\u0435 \u0441\u0442\u0440\u0435\u043B\u043A\u0438
    \u0440\u0430\u0441\u043A\u0430\u0447\u0438\u0432\u0430\u044E\u0442 \u0431\u0430\u043A.
    \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0438\u0445
    \u0432\u043C\u0435\u0441\u0442\u0435, \u0447\u0442\u043E\u0431\u044B \u043D\u0435
    \u043F\u0440\u043E\u043B\u0438\u0442\u044C \u0432\u043E\u0434\u0443."
  - "\u041D\u0430 \u0441\u0442\u044B\u043A\u0430\u0445 \u0441\u0431\u0430\u0432\u043B\u044F\u0439\u0442\u0435
    \u0445\u043E\u0434; \u0441\u0432\u0435\u0440\u0445\u0443 \u0431\u0435\u0440\u0435\u0433\u0438\u0442\u0435\u0441\u044C
    \u0431\u0430\u043B\u043A\u0438. \u0427\u0443\u0436\u0443\u044E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0443\u044E
    \u0442\u0435\u043B\u0435\u0436\u043A\u0443 \u043C\u043E\u0436\u043D\u043E \u0443\u043A\u0440\u0430\u0441\u0442\u044C
    \u043F\u043E E \u0438 \u0441\u043B\u0438\u0442\u044C \u0443 \u0441\u0432\u043E\u0435\u0433\u043E
    \u043D\u0430\u0441\u043E\u0441\u0430."
  tutorialQuickHints:
  - "WASD \u2014 \u043A\u0430\u0442\u0438\u0442\u044C \xB7 \u043D\u0430\u0437\u0430\u0434
    \u2014 \u0442\u043E\u0440\u043C\u043E\u0437\u0438\u0442\u044C"
  - "E \u2014 \u0432\u0437\u044F\u0442\u044C\u0441\u044F / \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
  - "\u041B\u041A\u041C \u2014 \u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C \u0442\u0435\u043B\u0435\u0436\u043A\u0443
    / \u0443\u0434\u0430\u0440"
