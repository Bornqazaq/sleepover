  cameraMode: 0
  objective: "\u0414\u043E\u043D\u0435\u0441\u0438\u0442\u0435 \u0432 \u0441\u0432\u043E\u0439
    \u0431\u0430\u043A \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u043E\u0434\u044B,
    \u0447\u0435\u043C \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A. \u0411\u044B\u0441\u0442\u0440\u0435\u0435
    \u2014 \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442 \u043B\u0443\u0447\u0448\u0435:
    \u0441\u043F\u0440\u0438\u043D\u0442 \u0441 \u0431\u0443\u0442\u044B\u043B\u044C\u044E
    \u0435\u0451 \u043F\u0435\u0440\u0435\u043A\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
    \u0438 \u0432\u043E\u0434\u0430 \u0443\u0445\u043E\u0434\u0438\u0442 \u043D\u0430
    \u0431\u0435\u0442\u043E\u043D."
  controlHints:
  - "E \u2014 \u0432\u0437\u044F\u0442\u044C\u0441\u044F \u0437\u0430 \u0431\u0443\u0442\u044B\u043B\u044C
    \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0435\u0451"
  - "\u0414\u0435\u0440\u0436\u0430\u0442\u044C E \u0443 \u0448\u0442\u0430\u0431\u0435\u043B\u044F
    \u2014 \u0432\u0437\u044F\u0442\u044C \u043D\u043E\u0432\u0443\u044E \u0431\u0443\u0442\u044B\u043B\u044C"
  - "\u041B\u041A\u041C \u0441 \u0431\u0443\u0442\u044B\u043B\u044C\u044E \u2014
    \u0448\u0432\u044B\u0440\u043D\u0443\u0442\u044C \u0435\u0451 \u0432\u0441\u0435\u0439
